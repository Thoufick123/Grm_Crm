# =========================================================================
# GRM WHATSAPP CRM — APACHE PRODUCTION CONFIGURATION (.htaccess)
# Security Hardening, MIME Types, Compression & File Protection
# =========================================================================

Options -Indexes -MultiViews

# 1. Protect Sensitive Configuration, Database Dumps & Secret Files
<FilesMatch "^\.|\.env|\.env\..*|whatsapp_account_config\.json|live_messages_queue\.json|webhook_logs\.json|database\.sql|\.log$">
    Require all denied
</FilesMatch>

# 2. Block Direct Browser Access to Sensitive Directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^bridge/auth_sessions(/.*)?$ - [F,L]
    RewriteRule ^bridge/auth_session(/.*)?$ - [F,L]
    RewriteRule ^\.git(/.*)?$ - [F,L]
</IfModule>

# 3. Security Headers for Production Protection
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression for High Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# 5. Production Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
